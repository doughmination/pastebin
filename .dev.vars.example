# .dev.vars.example
# Copy to .dev.vars for `bun run dev` / `wrangler dev`. In production these
# come from wrangler.jsonc "vars", and OIDC_CLIENT_SECRET from
# `wrangler secret put OIDC_CLIENT_SECRET`.

# Public origin of this pastebin. It is what paste links look like and what the
# redirect URI is built from, so it must match what the auth server has
# registered for this client.
ORIGIN=http://localhost:5173

SITE_NAME=Doughmination Paste

# --- Doughmination SSO ---------------------------------------------------------
# Register this pastebin at the auth server's /admin -> Applications, with
# redirect URI  <ORIGIN>/auth/callback  and post-logout redirect  <ORIGIN>/
OIDC_ISSUER=https://auth.doughmination.gay
OIDC_CLIENT_ID=pastebin

# Leave empty for a public client (PKCE only). Set it for a confidential one.
OIDC_CLIENT_SECRET=

# --- limits --------------------------------------------------------------------
# Largest paste accepted, in bytes.
MAX_BODY_BYTES=524288

# Pastes larger than this are shown as plain text: tokenizing megabytes of code
# stalls the Worker's CPU budget.
MAX_HIGHLIGHT_BYTES=196608
