{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pastebin",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },

  "routes": [
    {
      "pattern": "pastes.doughmination.gay",
      "custom_domain": true
    }
  ],

  // Users, sessions, in-flight sign-ins and pastes
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pastebin",
      "database_id": "efef3c06-9f54-481d-81c5-34bcd8e0dfe9",
      "migrations_dir": "migrations"
    }
  ],

  // Secrets (wrangler secret put): OIDC_CLIENT_SECRET, if the client is confidential
  "vars": {
    "ORIGIN": "https://pastes.doughmination.gay",
    "SITE_NAME": "Doughmination Paste",
    "OIDC_ISSUER": "https://auth.doughmination.gay",
    "OIDC_CLIENT_ID": "pastebin",
    "MAX_BODY_BYTES": "524288",
    "MAX_HIGHLIGHT_BYTES": "196608"
  },

  "observability": {
    "enabled": true
  }
}
